{
  "name": "project-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "PATH=/opt/homebrew/bin:$PATH npm --prefix apps/api run start:dev",
    "dev:web": "PATH=/opt/homebrew/bin:$PATH npm --prefix apps/web run dev",
    "build:api": "PATH=/opt/homebrew/bin:$PATH npm --prefix apps/api run build",
    "build:web": "PATH=/opt/homebrew/bin:$PATH npm --prefix apps/web run build",
    "build": "PATH=/opt/homebrew/bin:$PATH npm --prefix apps/api run build && PATH=/opt/homebrew/bin:$PATH npm --prefix apps/web run build"
  }
}
